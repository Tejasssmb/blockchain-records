# Environment Configuration (for reference - not required for basic deployment)
# This file shows available environment variables

# Flask Configuration
FLASK_ENV=production
DEBUG=False
PORT=5000

# Optional: For future database integration
DATABASE_URL=

# Optional: For API keys
SECRET_KEY=your_secret_key_here

# Optional: Web3 Configuration
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Notes:
# - This is just a template
# - For this project, you don't need a .env file for basic deployment
# - All data is stored in-memory
# - Create .env file only if you add new features requiring environment variables
